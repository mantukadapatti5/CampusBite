PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_canteen
DB_USER=canteen_user
DB_PASSWORD=canteen_pass
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Number of orders a single pickup slot can absorb before the system
# pushes new orders to the next slot. Tune this per canteen capacity.
SLOT_CAPACITY=15
# Length of each pickup slot in minutes
SLOT_DURATION_MINUTES=10
